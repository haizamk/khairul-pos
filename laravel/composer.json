{
    "name": "khairul/fresh-food-pos",
    "type": "project",
    "description": "Khairul Fresh Food POS - Laravel 13 & Livewire 4 with Firebase Firestore",
    "keywords": ["framework", "laravel", "livewire", "pos", "firebase"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "chillerlan/php-qrcode": "^6.0",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
