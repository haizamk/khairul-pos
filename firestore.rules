rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "vpsrush@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "master_admin")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "admin")
      );
    }

    function isCashier() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "cashier";
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      // Cashiers can read their own user document; Admins can read all staff
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // On CREATE:
      // - Master Admin can create any profile.
      // - Admin can create staff profiles (cannot create master_admin).
      // - Self-profile creation strictly enforces role == 'cashier' and status == 'active'.
      allow create: if isMasterAdmin() ||
        (isAdmin() && request.resource.data.role != "master_admin") ||
        (isSignedIn() && request.auth.uid == userId && request.resource.data.role == "cashier" && request.resource.data.status == "active");

      // On UPDATE:
      // - Master Admin can update any profile.
      // - Admin can update staff profiles (cannot promote to master_admin).
      // - Self-profile update CANNOT modify role, status, uid, or loginId.
      allow update: if isMasterAdmin() ||
        (isAdmin() && request.resource.data.role != "master_admin") ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.loginId == resource.data.loginId);

      // On DELETE:
      // Only Master Admin can delete user documents
      allow delete: if isMasterAdmin();
    }

    // 2. PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 3. CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 4. CUSTOMERS COLLECTION
    match /customers/{customerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 5. TRANSACTIONS COLLECTION
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isMasterAdmin();
    }

    // 6. HELD TICKETS COLLECTION
    match /held_tickets/{ticketId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // 7. SETTINGS COLLECTION (Store config & receipt settings for POS UI)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
